{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "okolariet-api",
    "Audience": "okolariet-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8
  },
  "Cors": {
    "WebOrigin": "https://localhost:7123"
  },
  "FileStorage": {
    "RootPath": "uploads"
  }
}