# JWT signing secret. Must be at least 32 bytes, otherwise the API refuses to start.
JwtSettings__Secret=

# Password for SQL Server's sa user (used by docker-compose.yml).
# SQL Server requires at least 8 characters with upper case, lower case, digits and symbols.

# Used when the Host runs locally (outside Docker) against the SQL container's published port 14330.
# Example: Server=localhost,14330;Database=okolariet;User Id=sa;Password=<MSSQL_SA_PASSWORD>;Encrypt=True;TrustServerCertificate=True
ConnectionStrings__Okolariet=

# The first admin, created automatically when the Staff table is empty.
# The password must satisfy the PasswordPolicy (upper and lower case, digit, symbol, no spaces, no part of the e-mail).
# Use at least 12 characters to match the API contract.
SeedAdmin__Email=
SeedAdmin__Password=