@page "/kiosk/{ProjectId:guid}"
@layout BlankLayout
@inject IVersionGateway VersionGateway
@inject IJSRuntime JS

@* The kiosk: what guests see on the touch screen. Opened in its own window from Admin → Udstillinger → Start.
   Anonymous: it only uses public endpoints (BearerTokenHandler leaves kiosk calls alone).
   Shows the latest published version page by page. Menu buttons lead into their pages; the bar at the bottom
   goes back, home, or on to the next page in the path ("next" slot, see PathConvention). The code is in KioskStart.razor.cs. *@

<PageTitle>Økolariet</PageTitle>

@* @oncontextmenu:preventDefault: no right-click menu, even before the JavaScript lock below has loaded. *@
<main class="kiosk" style="@KioskStyle" @oncontextmenu:preventDefault="true">
    @if (current is not null)
    {
        <div class="screen">
            <TemplateHost Page="current" Inherited="version?.Appearance" ProjectId="ProjectId" OnNavigate="GoTo" />
        </div>

        @* Always there (also when empty), so the screen above never jumps when the buttons appear. *@
        <nav class="kiosk-nav" aria-label="Navigation">
            @if (history.Count > 0)
            {
                <button type="button" class="kiosk-btn" @onclick="Back"><Icon Name="arrow_back" /> Tilbage</button>
                <button type="button" class="kiosk-btn" @onclick="Home"><Icon Name="home" /> Forside</button>
            }
            @if (Progress is { } progress)
            {
                <span class="kiosk-progress" role="status" aria-label="Side @progress.Index af @progress.Total">
                    @if (progress.Total <= 8)
                    {
                        @for (var i = 1; i <= progress.Total; i++)
                        {
                            <span class="kiosk-dot @(i == progress.Index ? "kiosk-dot-on" : null)"></span>
                        }
                    }
                    <span class="kiosk-progress-text">Side @progress.Index / @progress.Total</span>
                </span>
            }
            @if (NextId is Guid next)
            {
                <button type="button" class="kiosk-btn kiosk-btn-next" @onclick="() => GoTo(next)">
                    Videre <Icon Name="arrow_forward" />
                </button>
            }
        </nav>
    }
    else if (errorMessage is not null)
    {
        <div class="kiosk-message">
            <Icon Name="error" Class="kiosk-message-icon" />
            <h1 tabindex="-1">@errorMessage</h1>
        </div>
    }
    else
    {
        <p class="kiosk-message">Indlæser udstillingen…</p>
    }

    @if (!isFullscreen)
    {
        <button type="button" class="fullscreen-overlay" @onclick="EnterFullscreenAsync">
            <Icon Name="touch_app" Class="overlay-icon" />
            <span class="overlay-title">Tryk for at starte</span>
            <span class="overlay-sub">Udstillingen fylder hele skærmen</span>
        </button>
    }
</main>
