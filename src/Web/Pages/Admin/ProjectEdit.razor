@page "/admin/projects/{ProjectId:guid}"
@layout AdminLayout
@attribute [Authorize]
@inject ExhibitionLoader Loader
@inject ExhibitionEditor Editing

@* The editor of one exhibition. From the top:
   1. no main menu yet → pick a menu template and create it;
   2. the main menu: its texts, its buttons with their paths of pages (ButtonPathList), and a live preview;
   3. Udseende (colours and font, AppearanceEditor);
   4. pages no button leads to ("Sider uden knap"), so they can be deleted;
   5. the dialogs. Only one is open at a time, chosen by "dialog" (see DialogKind in ProjectEdit.razor.cs).
   All changes go through ExhibitionEditor, and the page reloads the whole model after each change. *@

<PageTitle>@(model?.Project.Name ?? "Rediger") · Økolariet</PageTitle>

<a class="back" href="admin/projects"><Icon Name="arrow_back" /> Alle udstillinger</a>

@if (model is null)
{
    if (loadError is null)
    {
        <p class="page-loading" aria-busy="true"><Icon Name="hourglass_top" /> Indlæser udstillingen…</p>
    }
    else
    {
        <LoadError Title="Udstillingen kunne ikke hentes" Message="@loadError" OnRetry="ReloadAsync" />
    }
}
else
{
    <header class="page-head">
        <div class="title-block">
            <h1 tabindex="-1">@model.Project.Name</h1>
            <div class="title-meta">
                <PublishStatus Version="model.Project.LatestVersionNumber" />
                <button type="button" class="link-button" @onclick="() => Open(DialogKind.Rename)">
                    <Icon Name="edit" /> Skift navn
                </button>
            </div>
        </div>

        <button type="button" class="btn btn-primary btn-lg" disabled="@(model.Menu is null)"
                @onclick="() => Open(DialogKind.Publish)">
            <Icon Name="publish" /> Udgiv
        </button>
    </header>

    <NoticeBar Notice="notice" OnClose="() => notice = null" />

    @if (model.Menu is null)
    {
        <section class="panel section" aria-labelledby="menu-heading">
            <PanelHead IconName="home" Title="Vælg hovedmenu" Id="menu-heading">
                Alle udstillinger starter med en hovedmenu. Vælg, hvordan den skal se ud.
            </PanelHead>

            @if (MenuTemplates.Count == 0)
            {
                <p class="section-lead">Serveren har ingen menu-skabeloner endnu, så hovedmenuen kan ikke oprettes.</p>
            }
            else
            {
                <TemplateCards Templates="MenuTemplates" Selected="SelectedMenuType" SelectedChanged="SelectMenuType"
                               Legend="Vælg menu" ShowGroupHeadings="false" />

                <button type="button" class="btn btn-primary create-menu" disabled="@busy" @onclick="CreateMenuAsync">
                    <Icon Name="add" /> @(busy ? "Opretter…" : "Opret hovedmenu")
                </button>
            }
        </section>
    }
    else
    {
        <div class="editor-grid">
            <section class="panel" aria-labelledby="menu-heading">
                <PanelHead IconName="home" Title="Hovedmenu" Id="menu-heading">
                    <ChildContent>
                        Det første, gæsterne ser. Hver knap fører ind i et forløb af sider, der vises efter hinanden.
                        Et forløb kan også ende i en undermenu med sine egne knapper.
                    </ChildContent>
                    <Aside>
                        <span class="template-tag"><Icon Name="dashboard" /> @model.DisplayNameOf(model.Menu.TemplateType)</span>
                    </Aside>
                </PanelHead>

                @if (MenuTextSlots.Count > 0)
                {
                    <div class="menu-texts">
                        @foreach (var slot in MenuTextSlots)
                        {
                            <div @key="slot.Key">
                                <label for="@($"text-{slot.Key}")" class="field-label">@slot.Label</label>
                                <input id="@($"text-{slot.Key}")" class="input" value="@MenuText(slot.Key)"
                                       maxlength="@(slot.MaxLength ?? 500)" autocomplete="off" disabled="@busy"
                                       @onchange="e => SaveMenuTextAsync(slot, e.Value?.ToString() ?? string.Empty)" />
                            </div>
                        }
                    </div>
                }

                <h3 class="sub-heading">Knapper og forløb</h3>

                @if (model.Buttons.Count == 0)
                {
                    <p class="section-lead">Den valgte menu har ingen knapper.</p>
                }

                <ButtonPathList Buttons="model.Buttons" Model="model" Busy="busy"
                                OnLabelChanged="SaveLabelAsync" OnAddPage="AskAdd" OnRemovePage="AskRemove" />
            </section>

            <aside class="panel preview-panel" aria-labelledby="preview-heading">
                <PanelHead IconName="visibility" Title="Forhåndsvisning" Id="preview-heading">
                    Sådan ser hovedmenuen ud på skærmen. Tomme felter vises med stiplet kant.
                </PanelHead>
                <div class="preview-stage">
                    <TemplateHost Page="MenuPage!" Inherited="model.Project.Appearance"
                                  Definition="model.MenuTemplate" Preview="true" Placeholders="true" />
                </div>
            </aside>
        </div>
    }

    <section class="panel section" aria-labelledby="look-heading">
        <PanelHead IconName="palette" Title="Udseende" Id="look-heading">
            Farver og skrifttype for hele udstillingen. Vælg et færdigt tema, eller sæt farverne sammen selv.
        </PanelHead>
        <AppearanceEditor Value="model.Project.Appearance"
                          PreviewPage="MenuPage"
                          PreviewDefinition="model.MenuTemplate"
                          Save="appearance => Editing.SaveAppearanceAsync(model!, appearance)"
                          OnSaved="OnAppearanceSaved" />
    </section>

    @if (model.Orphans.Count > 0)
    {
        <section class="panel section" aria-labelledby="orphans-heading">
            <PanelHead IconName="link_off" Title="Sider uden knap" Id="orphans-heading">
                Disse sider er ikke koblet til nogen knap, så gæsterne kan ikke nå dem. Slet dem, hvis de ikke skal bruges.
            </PanelHead>
            <ul class="steps">
                @foreach (var moddedTemplate in model.Orphans)
                {
                    <li class="step step-orphan" @key="moddedTemplate.Id">
                        <div class="step-info">
                            <strong>@moddedTemplate.Title</strong>
                            <small>@model.DisplayNameOf(moddedTemplate.TemplateType)</small>
                        </div>
                        <button type="button" class="btn btn-danger-ghost btn-sm"
                                aria-label="@($"Slet {moddedTemplate.Title}")" @onclick="() => AskDeleteOrphan(moddedTemplate)">
                            <Icon Name="delete" /> Slet
                        </button>
                    </li>
                }
            </ul>
        </section>
    }

    @switch (dialog)
    {
        case DialogKind.Rename:
            <NameDialog Title="Skift navn på udstillingen" Label="Nyt navn"
                        Value="@model.Project.Name" SubmitText="Gem navn"
                        Submit="name => Editing.RenameProjectAsync(model!, name)"
                        OnDone="OnRenamed" OnCancel="CloseDialog" />
            break;

        case DialogKind.AddPage when activeButton is not null:
            <TemplatePickerDialog Title="@($"Vælg skabelon til side {activeButton.Pages.Count + 1}")"
                                  Templates="model.Templates" Notes="NotesFor"
                                  Submit="type => Editing.AddPageAsync(model!, activeButton!, type)"
                                  OnDone="OnPageAdded" OnCancel="CloseDialog" />
            break;

        case DialogKind.RemovePage when activeButton is not null:
            var removing = activeButton.Pages[removeIndex];
            var below = removing.SubPages().Count();
            <ConfirmDialog Title="@($"Fjern «{removing.Page.Title}»?")"
                           Tone="DialogTone.Danger" ConfirmText="Fjern og slet siden" BusyText="Fjerner…"
                           Run="() => Editing.RemovePageAsync(activeButton!, removeIndex)"
                           OnDone="OnPageRemoved" OnCancel="CloseDialog">
                <p class="callout callout-danger">
                    <strong>Det kan ikke fortrydes.</strong>
                    Siden bliver slettet med alt, der står på den.
                </p>
                @if (below > 0)
                {
                    <p class="callout callout-danger">
                        Det er en undermenu. De @below sider under den bliver også slettet.
                    </p>
                }
                else
                {
                    <p>De øvrige sider i forløbet rykker op, så forløbet stadig hænger sammen.</p>
                }
            </ConfirmDialog>
            break;

        case DialogKind.DeleteOrphan when orphan is not null:
            <ConfirmDialog Title="@($"Slet «{orphan.Title}»?")"
                           Tone="DialogTone.Danger" ConfirmText="Slet siden" BusyText="Sletter…"
                           Run="() => Editing.DeletePageAsync(orphan!)"
                           OnDone="OnOrphanDeleted" OnCancel="CloseDialog">
                <p class="callout callout-danger">
                    <strong>Det kan ikke fortrydes.</strong>
                    Siden bliver slettet med alt, der står på den.
                </p>
            </ConfirmDialog>
            break;

        case DialogKind.Publish:
            <ConfirmDialog Title="@($"Udgiv «{model.Project.Name}»?")"
                           ConfirmText="Udgiv" BusyText="Udgiver…"
                           Run="PublishAsync" OnDone="OnPublished" OnCancel="CloseDialog">
                @if (model.Project.LatestVersionNumber is { } current)
                {
                    <p>Der bliver lavet en ny version (nu er den nyeste version @current). De gamle versioner ligger stadig gemt.</p>
                }
                else
                {
                    <p>Det er første gang, udstillingen udgives. Bagefter kan den startes på skærmen.</p>
                }
                <p>En skærm, der allerede kører udstillingen, skal startes forfra for at vise den nye udgave.</p>
            </ConfirmDialog>
            break;
    }
}
