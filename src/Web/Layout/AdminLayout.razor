@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

<div class="admin-shell">
    <aside class="sidebar">
        <a class="brand" href="admin/projects">
            <span class="brand-mark"><Icon Name="eco" /></span>
            <span class="brand-text">
                <strong>ØKOLARIET</strong>
                <small>Administration</small>
            </span>
        </a>

        <nav class="nav" aria-label="Hovedmenu">
            <p class="nav-caption">Menu</p>
            <NavLink class="nav-item" href="admin/projects" Match="NavLinkMatch.Prefix">
                <Icon Name="slideshow" /> <span>Udstillinger</span>
            </NavLink>
            <NavLink class="nav-item" href="admin/highscores" Match="NavLinkMatch.Prefix">
                <Icon Name="leaderboard" /> <span>Highscores</span>
            </NavLink>
            <NavLink class="nav-item" href="admin/media" Match="NavLinkMatch.Prefix">
                <Icon Name="perm_media" /> <span>Mediebibliotek</span>
            </NavLink>
            <NavLink class="nav-item" href="admin/templates" Match="NavLinkMatch.Prefix">
                <Icon Name="dashboard" /> <span>Skabeloner</span>
            </NavLink>
            <NavLink class="nav-item" href="admin/settings" Match="NavLinkMatch.Prefix">
                <Icon Name="settings" /> <span>Indstillinger</span>
            </NavLink>
        </nav>

        <div class="sidebar-foot">
            <AuthorizeView>
                <Authorized>
                    <div class="signed-in">
                        <span class="avatar"><Icon Name="person" /></span>
                        <span class="signed-in-text">
                            <span class="signed-in-label">Logget ind som</span>
                            <span class="signed-in-email" title="@context.User.Identity?.Name">@context.User.Identity?.Name</span>
                        </span>
                    </div>
                </Authorized>
            </AuthorizeView>
            <button type="button" class="logout" @onclick="LogoutAsync" disabled="@loggingOut">
                <Icon Name="logout" /> @(loggingOut ? "Logger ud…" : "Log ud")
            </button>
        </div>
    </aside>

    <main class="admin-main">
        <div class="admin-content">
            @Body
        </div>
    </main>
</div>

@code {
    private bool loggingOut;

    private async Task LogoutAsync()
    {
        loggingOut = true;
        await Auth.LogoutAsync();
        Nav.NavigateTo("admin/login", replace: true);
    }
}
