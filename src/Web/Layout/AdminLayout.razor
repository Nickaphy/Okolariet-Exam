@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

@* The frame around every admin page: the green menu on the left (logo, pages, who is logged in, log out) and the page itself. *@

<div class="admin-shell">
    <aside class="sidebar">
        <a class="brand" href="admin/projects">
            <span class="brand-mark"><Icon Name="eco" /></span>
            <span class="brand-text">
                <strong>ØKOLARIET</strong>
                <small>Administration</small>
            </span>
        </a>

        <nav class="nav" aria-label="Hovedmenu">
            <p class="nav-caption">Menu</p>
            @foreach (var item in NavItems)
            {
                <NavLink class="nav-item" href="@item.Href" Match="NavLinkMatch.Prefix">
                    <Icon Name="@item.Icon" /> <span>@item.Text</span>
                </NavLink>
            }
        </nav>

        <div class="sidebar-foot">
            <AuthorizeView>
                <Authorized>
                    <div class="signed-in">
                        <span class="avatar"><Icon Name="person" /></span>
                        <span class="signed-in-text">
                            <span class="signed-in-label">Logget ind som</span>
                            <span class="signed-in-email" title="@context.User.Identity?.Name">@context.User.Identity?.Name</span>
                        </span>
                    </div>
                </Authorized>
            </AuthorizeView>
            <button type="button" class="logout" @onclick="LogoutAsync" disabled="@loggingOut">
                <Icon Name="logout" /> @(loggingOut ? "Logger ud…" : "Log ud")
            </button>
        </div>
    </aside>

    <main class="admin-main">
        <div class="admin-content">
            @Body
        </div>
    </main>
</div>

@code {
    // The menu on the left. NavLink marks the item whose address the current page starts with.
    private static readonly (string Href, string Icon, string Text)[] NavItems =
    [
        ("admin/projects", "slideshow", "Udstillinger"),
        ("admin/highscores", "leaderboard", "Highscores"),
        ("admin/media", "perm_media", "Mediebibliotek"),
        ("admin/templates", "dashboard", "Skabeloner"),
        ("admin/settings", "settings", "Indstillinger"),
    ];

    private bool loggingOut;

    private async Task LogoutAsync()
    {
        loggingOut = true;
        await Auth.LogoutAsync();
        Nav.NavigateTo("admin/login", replace: true);
    }
}
