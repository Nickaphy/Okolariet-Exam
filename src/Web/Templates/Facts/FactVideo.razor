@namespace Web.Templates.Facts
@using Web.Templates.Slots

@* Template "fact-video": a big video with a caption below. Slot keys: video, title. *@

<div class="fv">
    <SlotVideo Key="video" Class="fv-video" />
    <SlotText Key="title" Class="fv-title" Heading="true" />
</div>

@code {
    public static PageContent Sample() => new(Guid.Empty, "fact-video", "Fakta", null,
        new Dictionary<string, SlotContent>
        {
            ["title"] = new("Mød skildpadden, der spiste en pose"),
        });
}