@namespace Web.Templates.Quiz

@* Template "quiz-true-false": a statement and two big answer tiles side by side (typically "Sandt" and "Falsk").
   Quick to play, like Kahoot's true/false round. Slot keys: title, intro, background. *@

<QuizRunner>
    <div class="qtf">
        <QuizQuestionText />
        <QuizMedia Class="qtf-media" />
        <AnswerTiles Columns="2" />
    </div>
</QuizRunner>

@code {
    public static PageContent Sample() => QuizSamples.Page("quiz-true-false", QuizSamples.TrueFalse);
}
