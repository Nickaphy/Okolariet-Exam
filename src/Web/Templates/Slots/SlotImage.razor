@namespace Web.Templates.Slots

@* An image slot. ShowPlaceholder=false for images that sit behind everything (a background). *@

@if (Scope.Slot(Key)?.AssetId is Guid id)
{
    <img class="slot-image @Class" data-slot="@Key" alt="" src="@Scope.AssetUrl(id)" />
}
else if (Scope.Placeholders && ShowPlaceholder)
{
    <div class="slot-placeholder @Class" data-slot="@Key">@Scope.LabelOf(Key)</div>
}

@code {
    [CascadingParameter] public TemplateScope Scope { get; set; } = default!;
    [Parameter, EditorRequired] public string Key { get; set; } = string.Empty;
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool ShowPlaceholder { get; set; } = true;
}
