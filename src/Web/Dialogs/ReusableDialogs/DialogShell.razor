
@* The frame every dialog shares: dark backdrop, title, close button, body, button row, Escape to close.
   Specific dialogs (ConfirmDialog, NameDialog, TemplatePickerDialog) put their content inside this one,
   so the look and the keyboard behaviour only exist in one place. *@

<div class="backdrop">
    <div class="dialog dialog-@Tone.ToString().ToLowerInvariant() @(Wide ? "dialog-wide" : "")"
         role="@(Tone == DialogTone.Danger ? "alertdialog" : "dialog")"
         aria-modal="true" aria-labelledby="@titleId"
         @onkeydown="OnKeyDown">

        <div class="dialog-head">
            @if (Tone != DialogTone.Normal)
            {
                <span class="tone-icon"><Icon Name="@(Tone == DialogTone.Danger ? "delete_forever" : "warning")" /></span>
            }
            <h2 id="@titleId">@Title</h2>
            <button type="button" class="dialog-close" aria-label="Luk" disabled="@Busy" @onclick="OnClose">
                <Icon Name="close" />
            </button>
        </div>

        <div class="dialog-body">@ChildContent</div>

        <div class="dialog-actions">@Actions</div>
    </div>
</div>
