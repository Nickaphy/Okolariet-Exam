@* The coloured message strip at the top of a page. Draws nothing while Notice is null, so a page can
   simply write  <NoticeBar Notice="notice" OnClose="() => notice = null" />  without an @if around it.
   Without OnClose there is no close button (used for "Uploader 2 af 5 …"). *@

@if (Notice is not null)
{
    <div class="notice notice-@Notice.Kind" role="@(Notice.Kind == "error" ? "alert" : "status")">
        <Icon Name="@IconName" Class="notice-icon" />
        <span class="notice-text">@Notice.Text</span>
        @if (OnClose.HasDelegate)
        {
            <button type="button" class="notice-close" aria-label="Luk beskeden" @onclick="OnClose"><Icon Name="close" /></button>
        }
    </div>
}

@code {
    [Parameter] public Notice? Notice { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string IconName => Notice?.Kind switch
    {
        "success" => "check_circle",
        "error" => "error",
        _ => "info"
    };
}
