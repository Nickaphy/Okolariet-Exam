@* A group of template cards where one can be chosen (a radio group, so the keyboard works).
   Use with @bind-Selected. Notes adds small chips to a card, like "Brugt på side 1". They only inform; they never block a choice. *@

<fieldset class="cards-set">
    <legend class="sr-only">@Legend</legend>

    @foreach (var group in Templates.GroupBy(t => t.Category))
    {
        if (ShowGroupHeadings)
        {
            <h3 class="cards-group">@TemplateInfo.CategoryName(group.Key)</h3>
        }

        <div class="cards">
            @foreach (var template in group)
            {
                var chosen = Selected == template.Type;
                <label class="card @(chosen ? "card-selected" : "")" @key="template.Type">
                    <input type="radio" class="card-input" name="@groupName" checked="@chosen"
                           @onchange="() => SelectAsync(template.Type)" />
                    <TemplateSketch Template="template" />
                    <span class="card-name">@(template.DisplayName + (chosen ? " ✔" : ""))</span>
                    <span class="card-text">@TemplateInfo.Describe(template)</span>
                    @{
                        var notes = (Notes?.Invoke(template) ?? Enumerable.Empty<string>()).ToList();
                    }
                    @if (notes.Count > 0)
                    {
                        <span class="card-chips">
                            @foreach (var note in notes)
                            {
                                <span class="card-chip">@note</span>
                            }
                        </span>
                    }
                </label>
            }
        </div>
    }
</fieldset>